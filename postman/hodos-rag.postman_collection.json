              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"LLM available\", () => pm.expect(r.llm.available).to.be.true);",
                  "pm.test(\"bill router trained\", () => pm.expect(r.bill_router.trained).to.be.true);",
                  "console.log(`cache backend=${r.cache.backend} vlm available=${r.vlm.available}`);"
                ]
              }
            }
          ]
        },
        {
          "name": "V2 ingest policy (builds RAPTOR tree)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/v2/policy",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v2",
                "policy"
              ]
            },
            "description": "",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doc_id\": \"{{v2DocId}}\",\n  \"text\": \"Meal expenses in Mumbai are limited to 1500 rupees per day, inclusive of taxes.\\nGrade L3 employees follow the standard meal cap unless traveling\\ninternationally, see section 9.3 for exceptions to this rule.\\n\\nLodging expenses for Grade L3 employees in metro cities are capped at\\n6000 rupees per night. Vendor approval is required for all lodging bookings\\nabove the standard corporate rate.\\n\\nTransport claims must be accompanied by an itemized receipt for\\nreimbursement. Ride-share transport is capped at Rs. 800 per trip within\\ncity limits.\\n\\nInternational travel meal caps are waived entirely for approved business\\ntrips exceeding five days.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Append a nonce so each run builds a fresh tree and cached answers from earlier runs do not match.",
                  "const body = JSON.parse(pm.request.body.raw);",
                  "body.text += `\\n\\nPolicy reference ${Date.now()}.`;",
                  "pm.request.body.raw = JSON.stringify(body);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"multi-level tree\", () => pm.expect(Object.keys(pm.response.json().nodes_per_level).length).to.be.at.least(2));"
                ]
              }
            }
          ]
        },
