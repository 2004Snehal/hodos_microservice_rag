# Copy to .env to override docker-compose defaults.
HODOS_PORT=8000
OLLAMA_URL=http://host.docker.internal:11434
HODOS_LLM_MODEL=qwen3:4b
HODOS_VLM_MODEL=qwen3-vl:4b
HODOS_SEMANTIC_THRESHOLD=0.85
HODOS_CACHE_TTL_SECONDS=604800
# docling-serve for policy PDFs; compose default http://docling:5001.
# Local (non-Docker) runs: .venv-docling/bin/docling-serve run --port 5001
# HODOS_DOCLING_URL=http://localhost:5001
